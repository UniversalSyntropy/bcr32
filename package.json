{
  "name": "bcr32",
  "version": "0.0.0",
  "private": true,
  "description": "Structured reference, device data and tools for the Behringer BCR32.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"packages/**/*.test.ts\" \"tools/**/*.test.ts\"",
    "gen:schema": "node packages/device-data/src/cli.ts gen-schema",
    "check:schema": "node packages/device-data/src/cli.ts gen-schema --check",
    "validate:data": "node packages/device-data/src/cli.ts validate",
    "gen:tables": "node tools/gen-tables/src/cli.ts && node tools/gen-tables/src/llms-full.ts",
    "check:tables": "node tools/gen-tables/src/cli.ts --check && node tools/gen-tables/src/llms-full.ts --check",
    "gen:llms-full": "node tools/gen-tables/src/llms-full.ts",
    "check:docs": "node tools/docs-check/src/cli.ts",
    "check:coverage": "node tools/coverage-check/src/cli.ts",
    "check:privacy": "node tools/privacy-check/src/cli.ts tracked",
    "hooks": "node tools/privacy-check/src/cli.ts install-hooks",
    "build:midi-capture": "mkdir -p tools/midi-capture/build && swiftc -O -swift-version 5 -o tools/midi-capture/build/midi-capture tools/midi-capture/src/main.swift",
    "midi-capture": "tools/midi-capture/build/midi-capture",
    "check": "npm run lint:md && npm run typecheck && npm test && npm run check:schema && npm run validate:data && npm run check:tables && npm run check:docs && npm run check:coverage && npm run check:privacy"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "markdownlint-cli2": "~0.23.3",
    "typescript": "^7.0.2"
  }
}
