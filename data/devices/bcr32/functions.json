{
  "$schema": "../../schema/functions.schema.json",
  "functions": [
    {"id":"zaq.mode-toggle","mode":"zaq","elements":["B1"],"name":"Go to CTRL mode","action":"tap B1","scope":"global","source":{"source":"manual","ref":"reference §2"}},
