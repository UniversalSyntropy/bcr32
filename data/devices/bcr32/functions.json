    {"id":"zaq.scale-commit","mode":"zaq","elements":["B10","B11"],"name":"Write the scale into the notes","action":"press B10 and B11 together","description":"Changes the stored notes to the scale. The unit cannot undo this.","scope":"pattern","source":{"source":"manual","ref":"reference §6"}},
