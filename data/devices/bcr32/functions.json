    {"id":"zaq.pitch","mode":"zaq","elements":["B5"],"name":"Pitch","action":"press B5","values":"note-pitch","default":60,"scope":"step","note":"The ring shows the pitch. The last three ring LEDs show the playhead.","source":{"source":"manual","ref":"reference §5"}},
