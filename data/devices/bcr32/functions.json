    {"id":"zaq.wave-gain","mode":"zaq","elements":["B12","E34"],"name":"Wave generator gain","action":"hold B12 + turn E34","values":"wave-gain","default":50,"scope":"track","source":{"source":"manual","ref":"reference §5"}},
    {"id":"zaq.wave-rate","mode":"zaq","elements":["B12","E35"],"name":"Wave generator rate","action":"hold B12 + turn E35","values":"wave-rate","default":5,"scope":"track","source":{"source":"manual","ref":"reference §5"}},
