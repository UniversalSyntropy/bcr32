{
  "$schema": "../../schema/modes.schema.json",
  "modes": [
    {"id":"zaq","name":"ZAQ (sequencer)","kind":"mode","enter":[{"action":"tap B1","from":"ctrl","note":"B1 changes to pink."}],"exit":[{"action":"tap B1"}],"lit":[{"elements":["B1"],"colour":"pink"},{"elements":["B5","B6","B7","B8","B9","B10","B11","B12","B13","B14","B15","B16","B17","B18","B19","B20"],"colour":"pink","when":"the parameter is in use"},{"elements":["B21","B22","B23","B24"],"colour":"green","when":"the track plays"},{"elements":["B21","B22","B23","B24"],"colour":"green","blink":true,"when":"the track is the selected track"}],"note":"The unit shows this mode as ZQR. Global Settings sets the mode at power-up.","source":{"source":"manual","ref":"manual pp. 16–23, ch. 2; pp. 16, 19, ch. 3"}},
    {"id":"ctrl","name":"CTRL (controller)","kind":"mode","enter":[{"action":"tap B1","from":"zaq","note":"B1 changes to amber."}],"exit":[{"action":"tap B1"}],"lit":[{"elements":["B1"],"colour":"amber"}],"note":"The manual gives amber as the button colour of this mode. It does not list the lit buttons.","source":{"source":"manual","ref":"manual pp. 16–23, ch. 2"}},
    {"id":"global-settings","name":"Global Settings","kind":"menu","enter":[{"action":"B1 ×3s","note":"Works from ZAQ and from CTRL."}],"exit":[{"action":"tap B1"}],"lit":[{"elements":["B1","B5","B6","B7","B8","B9","B10","B11","B12","B13","B14","B15"],"colour":"blue"}],"source":{"source":"unit","firmware":"1.0.3","ref":"manual pp. 16–17, ch. 9","note":"The lit buttons are verified on a unit (2026-11-11). The manual lists B1 and B5 to B12 only. The enter and exit actions come from the manual."}},
    {"id":"cv-calibration","name":"CV calibration","kind":"menu","parent":"global-settings","enter":[{"action":"press B8","from":"global-settings","note":"The display shows MIN."}],"exit":[{"action":"press B1"}],"lit":[],"source":{"source":"manual","ref":"manual pp. 22–23, ch. 9"}},
    {"id":"zaq-settings","name":"ZAQ Settings","kind":"menu","parent":"zaq","enter":[{"action":"hold B59 + press B61","from":"zaq"}],"exit":[{"action":"press B60"}],"lit":[{"elements":["B5","B6","B7","B8"],"colour":"blue"}],"source":{"source":"manual","ref":"manual pp. 16–23, ch. 2; p. 17, ch. 9"}},
    {"id":"ctrl-settings","name":"CTRL Settings","kind":"menu","parent":"ctrl","enter":[{"action":"hold B59 + press B61","from":"ctrl"}],"exit":[{"action":"press B60"}],"lit":[{"elements":["B5","B6","B7"],"colour":"blue"}],"note":"The selected item flashes. A photo with B5 off and B6 and B7 blue shows three items.","source":{"source":"unit","firmware":"1.0.3","ref":"A6, P11","note":"The manual lists B5 and B6 only."}},
    {"id":"zaq-global","name":"ZAQ Global page","kind":"page","parent":"zaq","enter":[{"action":"press B59","from":"zaq"}],"exit":[{"action":"press B60"}],"lit":[],"note":"Each step encoder sets the global parameter that its lower label names.","source":{"source":"manual","ref":"manual pp. 16–23, ch. 2; pp. 20–21, ch. 6"}},
    {"id":"zaq-mixer","name":"ZAQ Mixer","kind":"page","parent":"zaq","enter":[{"action":"press B66","from":"zaq","note":"Stop the sequencer first."}],"exit":[{"action":"press B66"},{"action":"press B60"}],"lit":[{"elements":["B21","B22","B23","B24","B5","B6","B7","B8","B9","B10","B11","B12","B13","B14","B15","B16","B17","B18","B19","B20"],"colour":"green","when":"the track or the drum voice is on"},{"elements":["B21","B22","B23","B24","B5","B6","B7","B8","B9","B10","B11","B12","B13","B14","B15","B16","B17","B18","B19","B20"],"colour":"red","when":"the track or the drum voice is muted"}],"source":{"source":"manual","ref":"manual pp. 16–23, ch. 2; p. 20, ch. 7"}},
    {"id":"zaq-record","name":"Real-time record","kind":"state","parent":"zaq","enter":[{"action":"press B65","from":"zaq","note":"The display shows NOTE."}],"exit":[{"action":"press B65"}],"lit":[],"note":"B64 steps through the sub-modes NOTE, MONITOR and RECORD.","source":{"source":"manual","ref":"manual pp. 16–23, ch. 2; p. 19, ch. 7"}},
    {"id":"zaq-store","name":"ZAQ pattern store","kind":"state","parent":"zaq","enter":[{"action":"hold B61","from":"zaq"}],"exit":[{"action":"press B60"}],"lit":[{"elements":["B61"],"colour":"pink","when":"a pattern is stored but not yet made permanent"},{"elements":["B5","B6","B7","B8","B9","B10","B11","B12","B13","B14","B15","B16","B17","B18","B19","B20"],"colour":"green","when":"the slot holds a pattern"},{"elements":["B5","B6","B7","B8","B9","B10","B11","B12","B13","B14","B15","B16","B17","B18","B19","B20"],"colour":"green","blink":true,"when":"the slot holds the current pattern"}],"source":{"source":"inference","ref":"manual p. 19, ch. 7","note":"The manual says that B61 stays lit. It does not give the colour; pink is assumed from the mode colour."}},
    {"id":"zaq-load","name":"ZAQ pattern load","kind":"state","parent":"zaq","enter":[{"action":"press B62","from":"zaq"}],"exit":[{"action":"press B60"}],"lit":[{"elements":["B5","B6","B7","B8","B9","B10","B11","B12","B13","B14","B15","B16","B17","B18","B19","B20"],"colour":"green","when":"the slot holds a pattern"},{"elements":["B5","B6","B7","B8","B9","B10","B11","B12","B13","B14","B15","B16","B17","B18","B19","B20"],"colour":"green","blink":true,"when":"the slot holds the current pattern"}],"source":{"source":"manual","ref":"manual pp. 16, 18–19, ch. 3; p. 19, ch. 7"}},
    {"id":"ctrl-edit","name":"CTRL Edit","kind":"state","parent":"ctrl","enter":[{"action":"hold B59 + turn E","from":"ctrl","note":"A push of an encoder or a press of a button selects that control instead."}],"exit":[{"action":"press B60"}],"lit":[],"source":{"source":"manual","ref":"manual pp. 16–23, ch. 2; pp. 22–23, ch. 8"}},
    {"id":"ctrl-learn","name":"CTRL Learn","kind":"state","parent":"ctrl","enter":[{"action":"hold B62 + turn E","from":"ctrl","note":"A push of an encoder or a press of a button selects that control instead."}],"exit":[{"action":"press B60"}],"lit":[],"source":{"source":"manual","ref":"manual pp. 16–23, ch. 2; p. 23, ch. 8"}},
    {"id":"ctrl-store","name":"CTRL preset store","kind":"state","parent":"ctrl","enter":[{"action":"press B61","from":"ctrl"}],"exit":[{"action":"press B60"}],"lit":[],"source":{"source":"manual","ref":"manual p. 23, ch. 8"}},
    {"id":"memory-erase","name":"Erase menu","kind":"menu","enter":[{"action":"press B61"},{"action":"hold SEL + push E49"}],"exit":[{"action":"press B60"}],"lit":[],"note":"The menu opens from ZAQ and from CTRL. The items depend on the mode. The manual names the encoder as the 25th encoder (50); E49 is the working assumption.","source":{"source":"manual","ref":"manual pp. 20, 22, ch. 9; ch. 12"}},
    {"id":"sysex-export","name":"SysEx export menu","kind":"menu","enter":[{"action":"press B61"},{"action":"hold SEL + push E25"}],"exit":[{"action":"press B60"}],"lit":[],"note":"The menu opens from ZAQ and from CTRL. The items depend on the mode.","source":{"source":"manual","ref":"manual pp. 20, 22, ch. 9"}},
    {"id":"sysex-import","name":"SysEx import","kind":"state","enter":[{"action":"press B61"},{"action":"hold SEL + push E33"}],"exit":[{"action":"press B60"}],"lit":[],"note":"The unit waits for SysEx data. An import changes the memory of the unit.","source":{"source":"manual","ref":"manual pp. 20, 22, ch. 9"}}
  ]
}
