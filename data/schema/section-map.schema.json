{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "items": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "section",
              "menu",
              "table",
              "list",
              "figure"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "page": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "anchors": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[^#\\s]+\\.md#[a-z0-9][a-z0-9_-]*$"
            }
          },
          "excluded": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "kind",
          "title",
          "page"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false,
  "$id": "section-map.schema.json",
  "title": "section-map.json (schema version 1)"
}
