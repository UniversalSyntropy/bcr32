{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "styles": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "type": "string",
            "pattern": "^[0-9A-C]$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "rule": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)*$"
          },
          "status": {
            "type": "string",
            "enum": [
              "model-unverified",
              "model-disagrees",
              "unknown",
              "verified"
            ]
          },
          "source": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "enum": [
                  "manual",
                  "unit",
                  "community",
                  "inference"
                ]
              },
              "firmware": {
                "type": "string",
                "minLength": 1
              },
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "source"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "code",
          "name",
          "rule",
          "status",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "table": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  },
  "required": [
    "styles"
  ],
  "additionalProperties": false,
  "$id": "rings.schema.json",
  "title": "rings.json (schema version 1)"
}
