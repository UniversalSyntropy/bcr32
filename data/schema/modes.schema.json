{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "modes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "mode",
              "menu",
              "page",
              "state"
            ]
          },
          "parent": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)*$"
          },
          "enter": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string",
                  "minLength": 1
                },
                "from": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)*$"
                },
                "note": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "action"
              ],
              "additionalProperties": false
            }
          },
          "exit": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string",
                  "minLength": 1
                },
                "from": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)*$"
                },
                "note": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "action"
              ],
              "additionalProperties": false
            }
          },
          "lit": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "elements": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Z][A-Za-z0-9]*(\\.[a-z0-9]+)?$"
                  }
                },
                "colour": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)*$"
                },
                "blink": {
                  "type": "boolean"
                },
                "when": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "elements",
                "colour"
              ],
              "additionalProperties": false
            }
          },
          "manualAnchor": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "enum": [
                  "manual",
                  "unit",
                  "community",
                  "inference"
                ]
              },
              "firmware": {
                "type": "string",
                "minLength": 1
              },
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "source"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "enter",
          "exit",
          "lit",
          "source"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "modes"
  ],
  "additionalProperties": false,
  "$id": "modes.schema.json",
  "title": "modes.json (schema version 1)"
}
