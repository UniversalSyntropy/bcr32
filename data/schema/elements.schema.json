{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "elements": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]*(\\.[a-z0-9]+)?$"
          },
          "callout": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "kind": {
            "type": "string",
            "enum": [
              "button",
              "encoder",
              "led",
              "display",
              "jack"
            ]
          },
          "view": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)*$"
          },
          "group": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)*$"
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "placement": {
                  "type": "string",
                  "enum": [
                    "on",
                    "above",
                    "below",
                    "left",
                    "right",
                    "legend"
                  ]
                },
                "colour": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)*$"
                },
                "role": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "text",
                "placement"
              ],
              "additionalProperties": false
            }
          },
          "panelNumber": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "grid": {
            "type": "object",
            "properties": {
              "row": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "col": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "row",
              "col"
            ],
            "additionalProperties": false
          },
          "position": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false
          },
          "size": {
            "type": "object",
            "properties": {
              "w": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "h": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "w",
              "h"
            ],
            "additionalProperties": false
          },
          "push": {
            "type": "boolean"
          },
          "ringLeds": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "colours": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)*$"
            }
          },
          "connector": {
            "type": "string",
            "minLength": 1
          },
          "signal": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "enum": [
                  "manual",
                  "unit",
                  "community",
                  "inference"
                ]
              },
              "firmware": {
                "type": "string",
                "minLength": 1
              },
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "source"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "callout",
          "kind",
          "view",
          "group",
          "labels",
          "source"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "elements"
  ],
  "additionalProperties": false,
  "$id": "elements.schema.json",
  "title": "elements.json (schema version 1)"
}
