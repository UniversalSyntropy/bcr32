{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)*$"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "title": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)*$"
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "key",
        "en"
      ],
      "additionalProperties": false
    },
    "doc": {
      "type": "string",
      "minLength": 1
    },
    "firmware": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "verified",
        "unverified"
      ]
    },
    "start": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)*$"
        },
        "view": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "mode",
        "view"
      ],
      "additionalProperties": false
    },
    "steps": {
      "minItems": 1,
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)*$"
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "focus": {
            "minItems": 1,
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Za-z0-9]*(\\.[a-z0-9]+)?$"
            }
          },
          "target": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "after": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "held": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Za-z0-9]*(\\.[a-z0-9]+)?$"
            }
          },
          "caption": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)*$"
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "key",
              "en"
            ],
            "additionalProperties": false
          },
          "expect": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)*$"
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "key",
              "en"
            ],
            "additionalProperties": false
          },
          "advance": {
            "type": "string",
            "enum": [
              "on-action",
              "manual"
            ]
          },
          "warn": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)*$"
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "key",
              "en"
            ],
            "additionalProperties": false
          },
          "source": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "enum": [
                  "manual",
                  "unit",
                  "community",
                  "inference"
                ]
              },
              "firmware": {
                "type": "string",
                "minLength": 1
              },
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "source"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "focus",
          "caption",
          "advance"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "version",
    "title",
    "firmware",
    "status",
    "start",
    "steps"
  ],
  "additionalProperties": false,
  "$id": "guide.schema.json",
  "title": "guide file (schema version 1)"
}
