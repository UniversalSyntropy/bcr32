          "pattern": {
            "type": "string",
            "minLength": 1
          },
          "trigger": {
            "type": "object",
            "properties": {
              "elements": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Za-z0-9]*(\\.[a-z0-9]+)?$"
                }
              },
              "confidence": {
                "type": "string",
                "enum": [
                  "proven",
                  "likely",
                  "unproven"
                ]
              }
            },
            "required": [
              "elements",
              "confidence"
            ],
            "additionalProperties": false
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "enum": [
                  "manual",
                  "unit",
                  "community",
                  "inference"
                ]
              },
              "firmware": {
                "type": "string",
                "minLength": 1
              },
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "source"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "port",
          "mode",
          "direction",
          "type",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "silences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)*$"
          },
          "port": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)*$"
          },
          "mode": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)*$"
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "enum": [
                  "manual",
                  "unit",
                  "community",
                  "inference"
                ]
              },
              "firmware": {
                "type": "string",
                "minLength": 1
              },
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "source"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "mode",
          "action",
          "result",
          "source"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "usb",
    "ports",
    "messages",
    "silences"
  ],
  "additionalProperties": false,
  "$id": "midi.schema.json",
  "title": "midi.json (schema version 1)"
}
