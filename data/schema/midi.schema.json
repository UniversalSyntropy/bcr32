{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "usb": {
      "type": "object",
      "properties": {
        "vendorId": {
          "type": "string",
          "pattern": "^[0-9A-F]{4}$"
        },
        "productId": {
          "type": "string",
          "pattern": "^[0-9A-F]{4}$"
        },
        "release": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "enum": [
                "manual",
                "unit",
                "community",
                "inference"
              ]
            },
            "firmware": {
              "type": "string",
              "minLength": 1
            },
            "ref": {
              "type": "string",
              "minLength": 1
