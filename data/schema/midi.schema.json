        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "in",
                "out"
              ]
            }
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "enum": [
                  "manual",
                  "unit",
                  "community",
                  "inference"
                ]
              },
              "firmware": {
                "type": "string",
                "minLength": 1
              },
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "source"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "direction",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)*$"
          },
          "port": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)*$"
          },
          "mode": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)*$"
          },
          "direction": {
            "type": "string",
            "enum": [
              "out",
              "in"
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "cc",
              "note",
              "program-change",
              "clock",
              "start",
              "stop",
              "sysex"
            ]
          },
          "channel": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
          },
          "number": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "values": {
            "minItems": 1,
            "type": "array",
